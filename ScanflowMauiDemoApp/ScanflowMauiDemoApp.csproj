<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios;</TargetFrameworks>
		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>
		<OutputType>Exe</OutputType>
		<RootNamespace>ScanflowMauiDemoApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AndroidEnableAot>false</AndroidEnableAot>

		<!-- Display name -->
		<ApplicationTitle>ScanflowMauiDemoApp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.scanflow.mauidemo</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-android|AnyCPU'">
		<AndroidStoreUncompressedFileExtensions>.tflite</AndroidStoreUncompressedFileExtensions>
		<ApplicationId>com.scanflow.mauidemo</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-android|AnyCPU'">
		<AndroidStoreUncompressedFileExtensions>.tflite</AndroidStoreUncompressedFileExtensions>
		<ApplicationId>com.scanflow.mauidemo</ApplicationId>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidSigningKeyStore>/Users/racitsolutionspvtltd/Downloads/mauiscanflowdemo.jks</AndroidSigningKeyStore>
		<AndroidSigningStorePass>Optisol@2024</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>key0</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>Optisol@2024</AndroidSigningKeyPass>
		<AndroidApkSignerAdditionalArguments>Optisol@2024</AndroidApkSignerAdditionalArguments>
		<DebugSymbols>True</DebugSymbols>
		<JavaMaximumHeapSize>1G</JavaMaximumHeapSize>
		<AndroidLinkMode>None</AndroidLinkMode>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
		<ApplicationId>com.scanflow.mauidemo</ApplicationId>
		<CreatePackage>false</CreatePackage>
		<CodesignProvision>MAUI_dev_profile</CodesignProvision>
		<CodesignKey>iPhone Developer: Jayakumar Radhakrishnan (RJBMR3D2W2)</CodesignKey>
